# Chromium en kiosque, pointé sur le serveur local de l'agent.
# Il ne joint JAMAIS le serveur de l'école : tout ce qu'il demande est déjà
# sur la machine.
[Unit]
Description=Couloir — affichage kiosque
After=couloir-player.service graphical.target
Requires=couloir-player.service

# Le terminal, qu'il faut prendre à qui l'occupe.
#
# Le kiosque démarre son propre serveur X — voir kiosk.sh — et X veut un
# terminal virtuel. Or Raspberry Pi OS y lance une invite de connexion.
# Sans ces deux lignes, systemd attend indéfiniment un tty qu'il n'obtiendra
# jamais : le service se dit « actif », rien ne tourne, et le journal reste
# muet. C'est le pire des trois symptômes possibles, parce qu'il ressemble à
# un succès.
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=couloir
Environment=DISPLAY=:0
Environment=COULOIR_PORT=8080
TTYPath=/dev/tty1
StandardInput=tty-force
StandardOutput=journal
TTYVTDisallocate=yes
ExecStart=/opt/couloir/player/kiosk.sh
# Un verrou laissé par un X mort empêche le suivant de démarrer, et le
# service tourne alors en boucle sans jamais rien afficher.
#
# Le `+` fait tourner ce nettoyage en root, et il n'est pas facultatif :
# /tmp porte le bit collant, si bien que `couloir` ne peut pas effacer un
# fichier laissé par quelqu'un d'autre. Sans lui, le nettoyage échouait en
# silence et X refusait de s'ouvrir un socket.
ExecStartPre=+-/bin/rm -f /tmp/.X0-lock /tmp/.X11-unix/X0
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
