# Chromium en kiosque, pointé sur le serveur local de l'agent.
# Il ne joint JAMAIS le serveur de l'école : tout ce qu'il demande est déjà
# sur la machine.
[Unit]
Description=Couloir — affichage kiosque
After=couloir-player.service graphical.target
Requires=couloir-player.service

[Service]
Type=simple
User=couloir
Environment=DISPLAY=:0
# Le kiosque démarre son propre serveur X quand il n'en trouve pas — voir
# kiosk.sh. Il lui faut donc un terminal virtuel, que systemd ne donne pas
# par défaut à un service.
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
TTYVTDisallocate=yes
Environment=COULOIR_PORT=8080
ExecStart=/opt/couloir/player/kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
