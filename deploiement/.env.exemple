# Copiez ce fichier en `.env` à côté de `compose.yml`, puis remplissez-le.
# Ne le versionnez jamais : il contient cinq secrets.

# Le nom de domaine du serveur.
#
# Il n'a PAS besoin d'être joignable depuis Internet : le certificat s'obtient
# par vérification DNS, qui prouve qu'on contrôle la zone. Un enregistrement
# qui pointe vers une adresse privée convient donc parfaitement — mais il doit
# exister et résoudre, sinon les écrans ne trouveront pas le serveur.
COULOIR_DOMAINE=ecrans.exemple.fr

# Le nom vers lequel l'établissement délègue la vérification du certificat.
#
# Il pose UN enregistrement, une fois pour toutes :
#   _acme-challenge.ecrans  CNAME  _acme-challenge.ecrans-etab.notre-zone.fr.
# et cette variable reprend la cible, telle quelle. Caddy ne préfixe pas
# `_acme-challenge` de lui-même.
#
# Ce montage évite d'avoir à demander une clé d'API sur la zone de
# l'établissement. Une telle clé, même restreinte à la zone, permet de
# réécrire les MX du courrier et le site public : c'est beaucoup pour
# renouveler le certificat d'un écran de couloir.
#
# Les identifiants OVH plus bas sont alors ceux de NOTRE zone, pas de la
# sienne.
COULOIR_DEFI_DELEGUE=_acme-challenge.ecrans-etab.notre-zone.fr

# Le mot de passe de la base. Généré une fois, jamais réutilisé ailleurs :
#   openssl rand -hex 24
#
# En hexadécimal, et ce n'est pas un détail de style : base64 produit des
# barres obliques, qui coupent l'URL `postgres://couloir:MOT@base:5432/couloir`
# au milieu. Le serveur démarre alors et échoue à joindre une base dont le nom
# n'a plus de sens.
COULOIR_MOT_DE_PASSE_BASE=

# La clé de secours. Elle crée le premier administrateur à la première
# ouverture de la console, et rouvre la porte si le dernier administrateur
# perd son mot de passe. Elle ne publie rien et ne voit aucun écran.
#   openssl rand -hex 32
COULOIR_CONSOLE_TOKEN=

# --- L'accès à la zone DNS, pour le certificat -------------------------
#
# À générer sur https://api.ovh.com/createToken/
#
# Ne donnez que ce qui est nécessaire — la vérification DNS n'écrit que des
# enregistrements TXT temporaires dans la zone :
#
#   GET    /domain/zone/notre-zone.fr/*
#   POST   /domain/zone/notre-zone.fr/*
#   DELETE /domain/zone/notre-zone.fr/*
#
# Surtout pas de droit sur /me, /billing ou /dedicated : un jeton volé sur un
# Raspberry de couloir ne doit pas ouvrir le compte OVH.
#
# Laissez la validité illimitée : un jeton qui expire coupe le renouvellement
# du certificat trois mois plus tard, et personne ne fait le lien.
OVH_ENDPOINT=ovh-eu
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

# --- Les images ---------------------------------------------------------
#
# Laissez les défauts : elles sont publiées par l'intégration continue, pour
# amd64 et arm64. Ne les surchargez que pour construire sur place.
# COULOIR_IMAGE=ghcr.io/glowsoft-dev/couloir/serveur:main
# COULOIR_IMAGE_TLS=ghcr.io/glowsoft-dev/couloir/tls:main
