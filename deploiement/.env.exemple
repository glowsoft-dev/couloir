# Copiez ce fichier en `.env` à côté de `compose.yml`, puis remplissez-le.
# Ne le versionnez jamais : il contient deux secrets.

# Le nom de domaine du serveur. Caddy obtient le certificat pour celui-ci ;
# il doit donc pointer sur cette machine AVANT le premier démarrage.
COULOIR_DOMAINE=ecrans.exemple.fr

# Le mot de passe de la base. Généré une fois, jamais réutilisé ailleurs :
#   openssl rand -base64 24
COULOIR_MOT_DE_PASSE_BASE=

# Le jeton d'accès à la console. C'est aujourd'hui le seul secret qui protège
# la publication sur tous les écrans — les comptes nominatifs viendront.
#   openssl rand -base64 32
COULOIR_CONSOLE_TOKEN=

# L'image à déployer. Laissez le défaut si vous construisez sur place.
# COULOIR_IMAGE=couloir-serveur:latest
